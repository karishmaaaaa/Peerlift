    "socket.io": "^4.7.2",
    "redis": "^4.6.12",
    "bullmq": "^5.4.2",
    "groq-sdk": "^1.2.0",
    "axios": "^1.6.5",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "swagger-ui-express": "^4.6.3",
